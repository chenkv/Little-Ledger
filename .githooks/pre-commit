#!/usr/bin/env bash
set -euo pipefail

echo "Running pre-commit: linting and formatting staged files..."

# Get staged files that are added, copied, modified, or renamed.
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACMR)

if [ -z "$STAGED_FILES" ]; then
  echo "No staged files to lint or format."
  exit 0
fi

# Only lint files ESLint can handle.
ESLINT_FILES=$(echo "$STAGED_FILES" | grep -E '\.(js|jsx|ts|tsx|mjs|cjs)$' || true)

if [ -n "$ESLINT_FILES" ]; then
  echo "Running ESLint --fix on staged files..."
  echo "$ESLINT_FILES" | xargs bun run eslint -- --fix

  # Re-stage any fixes made by ESLint.
  echo "$ESLINT_FILES" | xargs git add
fi

# Only format files Prettier can handle.
PRETTIER_FILES=$(echo "$STAGED_FILES" | grep -E '\.(js|jsx|ts|tsx|mjs|cjs|json|css|scss|md|mdx|html|yaml|yml)$' || true)

if [ -n "$PRETTIER_FILES" ]; then
  echo "Running Prettier on staged files..."
  echo "$PRETTIER_FILES" | xargs bun run prettier --write

  # Re-stage any fixes made by Prettier.
  echo "$PRETTIER_FILES" | xargs git add
fi

echo "Pre-commit checks complete."

exit 0